# Copy this file to .env and fill only the providers used by the demo.
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=
QWEN_VL_MODEL=qwen-vl-plus
QWEN_CHAT_MODEL=qwen-plus
QWEN_ASR_MODEL=qwen3-asr-flash-2026-02-10
QWEN_ASR_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# 短语音转写最大7MB；音频不落盘，失败时前端回退浏览器语音识别。
MDM_MAX_ASR_BYTES=7340032

# Real OCR. PaddleOCR is lazy-loaded; use start-ocr.bat after install-ocr.bat.
MDM_PADDLEOCR_ENABLED=1
MDM_PADDLEOCR_LANG=ch
MDM_MAX_OCR_BYTES=10485760
MDM_OCR_WORKER_TIMEOUT=180
MDM_OCR_INSTALL_LOCK_SECONDS=3600
# Optional private or regional PyPI mirror used before built-in fallbacks.
MDM_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
# Only requests from the server computer may trigger this installer.
MDM_ALLOW_OCR_INSTALL=1

# Runtime settings. 0.0.0.0 allows other computers on the LAN to connect.
MDM_HOST=0.0.0.0
MDM_PORT=5000
MDM_THREADS=8
MDM_PRODUCTION=1
FLASK_DEBUG=0

# Persistent data and rotating application logs, relative to backend/.
MDM_DB_PATH=../runtime/data/mdm_data.db
MDM_LOG_DIR=../runtime/logs
MDM_MAX_RECORDS=10000
MDM_MAX_UPLOAD_BYTES=20971520

# Enterprise identity and access control. Generated initial credentials are stored under runtime/data.
MDM_SECURITY_MODE=enterprise
MDM_SESSION_MINUTES=480
MDM_MAX_FAILED_LOGINS=5
MDM_LOGIN_LOCK_MINUTES=15
MDM_COOKIE_SECURE=0
MDM_TRUSTED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
# Optional fixed bootstrap passwords. Leave empty to generate strong one-time passwords.
MDM_PASSWORD_GROUP_ADMIN=
MDM_PASSWORD_GROUP_APPROVER=
MDM_PASSWORD_SHANGHAI_STEWARD=
MDM_PASSWORD_COMPLIANCE_AUDITOR=

# Versioned standard RAG. The default workbook contains 72 entries, 12 aliases and 10 references.
MDM_RAG_ENABLED=1
MDM_RAG_AUTO_IMPORT=1
MDM_RAG_SOURCE_PATH=SY_T5497-2018备品备件分类树(1).xlsx
MDM_RAG_VERSION=2018
MDM_RAG_DIMENSION=384
MDM_RAG_TOP_K=3
MDM_RAG_RULE_WEIGHT=0.45
MDM_RAG_LEXICAL_WEIGHT=0.30
MDM_RAG_VECTOR_WEIGHT=0.25
MDM_RAG_AUTO_ACCEPT_THRESHOLD=0.68
MDM_RAG_MINIMUM_MARGIN=0.08
MDM_RAG_AUDIT_QUERIES=1
MDM_RAG_ALLOWED_PLANTS=*
MDM_RAG_ALLOWED_CLASSIFICATIONS=INTERNAL,CONFIDENTIAL,RESTRICTED
MDM_RAG_CLASSIFICATION=INTERNAL

# Optional source-system deep links. When configured, lineage records can open the real business object.
MDM_SAP_SOURCE_URL=
MDM_ERP_SOURCE_URL=
MDM_EAM_SOURCE_URL=
MDM_MES_SOURCE_URL=
MDM_WMS_SOURCE_URL=
MDM_PROCUREMENT_SOURCE_URL=

# Legacy compatibility only. Enterprise mode uses the four RBAC accounts above.
MDM_AUTH_USER=admin
MDM_AUTH_PASSWORD=
