# Copy this file to .env and fill only the providers used by the demo.
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=
QWEN_VL_MODEL=qwen-vl-plus

# Real OCR. PaddleOCR is lazy-loaded; use start-ocr.bat after install-ocr.bat.
MDM_PADDLEOCR_ENABLED=1
MDM_PADDLEOCR_LANG=ch
MDM_MAX_OCR_BYTES=10485760
MDM_OCR_WORKER_TIMEOUT=180
MDM_OCR_INSTALL_LOCK_SECONDS=3600
# Optional private or regional PyPI mirror used before built-in fallbacks.
MDM_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
# Only requests from the server computer may trigger this installer.
MDM_ALLOW_OCR_INSTALL=1

# Runtime settings. 0.0.0.0 allows other computers on the LAN to connect.
MDM_HOST=0.0.0.0
MDM_PORT=5000
MDM_THREADS=8
MDM_PRODUCTION=1
FLASK_DEBUG=0

# Persistent data and rotating application logs, relative to backend/.
MDM_DB_PATH=../runtime/data/mdm_data.db
MDM_LOG_DIR=../runtime/logs
MDM_MAX_RECORDS=10000
MDM_MAX_UPLOAD_BYTES=20971520

# Optional browser-level Basic authentication. Set a strong password for LAN use.
# Put the service behind HTTPS before using credentials over an untrusted network.
MDM_AUTH_USER=admin
MDM_AUTH_PASSWORD=
